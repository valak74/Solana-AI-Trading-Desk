# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.
# Ne jamais coller ces valeurs dans un chat, un ticket ou un commit.

APP_ENV=prod
# Seul "paper" est accepté à ce stade : toute autre valeur empêche le démarrage.
EXECUTION_MODE=paper
LOG_LEVEL=INFO
LOG_FORMAT=json

# Base de données (Docker Compose). Mot de passe : lettres et chiffres uniquement.
POSTGRES_USER=desk
POSTGRES_PASSWORD=
POSTGRES_DB=desk
# Hors Docker uniquement (développement local) :
# DATABASE_URL=postgresql+asyncpg://desk:motdepasse@localhost:5432/desk

# Alertes Telegram (optionnel ; les deux valeurs ensemble, ou aucune).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Surveillance externe healthchecks.io (optionnel) : URL de ping complète.
HEALTHCHECKS_PING_URL=
HEARTBEAT_INTERVAL_SECONDS=60

# --- Enregistrement des tokens (étape M2) ---------------------------------------------
INGEST_ENABLED=true
# Clé de l'API de données PumpPortal (wallet lié jetable, 0,02 SOL, jamais le wallet de trading).
PUMPPORTAL_API_KEY=
# Clé Helius (offre gratuite) : vérification on-chain d'un échantillon d'événements.
HELIUS_API_KEY=
# Part des événements vérifiés on-chain (0.02 = 2 %). 0 désactive la vérification.
VERIFY_SAMPLE_RATE=0.02
# Plafond de crédits Helius par jour (UTC), partagé par la vérification et l'analyse.
HELIUS_DAILY_CREDIT_BUDGET=25000

# --- Analyse de sécurité et score (étape M3) ------------------------------------------
ANALYSIS_ENABLED=true
# Second avis RugCheck (API publique, format non documenté) : désactivé par défaut.
RUGCHECK_ENABLED=false

# --- Paper trading (étape M4) : simulation uniquement, aucun wallet -------------------
PAPER_TRADING_ENABLED=true
# Clé Jupiter (gratuite, portail développeur) : cotations seulement. Nécessaire à la stratégie B.
JUPITER_API_KEY=

# --- Rapport de mesure (étape M5) ------------------------------------------------------
# Cours SOL/EUR et coût d'infrastructure mensuel utilisés par le rapport hebdomadaire.
REPORT_SOL_EUR=150
REPORT_INFRA_EUR=15
WEEKLY_SUMMARY_ENABLED=true

# Réglages avancés (valeurs par défaut raisonnables) :
# TRACKED_POOLS=["pump"]
# TRACK_WINDOW_MINUTES=90
# TRACK_MIGRATED_WINDOW_MINUTES=360
# MAX_TRACKED_TOKENS=2000
# FEED_STALE_AFTER_SECONDS=60
# SNAPSHOT_MIN_INTERVAL_SECONDS=5
# ANALYSIS_MIN_AGE_MINUTES=3
# ANALYSIS_MAX_AGE_MINUTES=30
# ANALYSIS_REANALYZE_MINUTES=10
# ANALYSIS_MIN_TRADES=15
