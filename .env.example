# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.
# Ne jamais coller ces valeurs dans un chat, un ticket ou un commit.

APP_ENV=prod
# Seul "paper" est accepté à ce stade : toute autre valeur empêche le démarrage.
EXECUTION_MODE=paper
LOG_LEVEL=INFO
LOG_FORMAT=json

# Base de données (Docker Compose). Mot de passe : lettres et chiffres uniquement.
POSTGRES_USER=desk
POSTGRES_PASSWORD=
POSTGRES_DB=desk
# Hors Docker uniquement (développement local) :
# DATABASE_URL=postgresql+asyncpg://desk:motdepasse@localhost:5432/desk

# Alertes Telegram (optionnel ; les deux valeurs ensemble, ou aucune).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Surveillance externe healthchecks.io (optionnel) : URL de ping complète.
HEALTHCHECKS_PING_URL=
HEARTBEAT_INTERVAL_SECONDS=60
